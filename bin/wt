#!/usr/bin/env bash
#
# wt - Git worktree setup for parallel Claude Code agents
#
# Creates a bare git repository structure optimized for multiple
# agents working in parallel worktrees.
#
# Usage:
#   wt <repo-url>           Clone from remote
#   wt <repo-url> <name>    Clone from remote with custom name
#   wt <name>               Initialize local project
#

set -euo pipefail

# Resolve script directory and load libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$(cd "$SCRIPT_DIR/../lib" && pwd)"

source "$LIB_DIR/parse.sh"
source "$LIB_DIR/repo.sh"
source "$LIB_DIR/agent.sh"

# Colors for output (disabled if not a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

usage() {
    cat <<EOF
Usage: wt <repo-url> [name]
       wt <name>
       wt agent <command> [args...]

Create a bare git repository structure for parallel worktrees.

Setup Commands:
  wt <repo-url> [name]    Clone from remote
  wt <name>               Initialize local project

Agent Commands:
  wt agent create <agent-name> <task-id> [base-branch]
                          Create agent worktree with branch task/<task-id>/<agent>
  wt agent remove <agent-name> [--delete-branch]
                          Remove agent worktree (optionally delete branch)
  wt agent list           List all agent worktrees
  wt agent check <agent-name>
                          Check merge conflicts and divergence
  wt agent sync <agent-name> [--auto-rebase]
                          Sync agent worktree with base branch
  wt agent prune [--older-than=Nd] [--dry-run]
                          Remove stale worktrees (default: >7 days)
  wt agent status         Show agent worktree dashboard

Examples:
  wt https://github.com/user/repo
  wt git@github.com:user/repo.git my-repo
  wt new-project
  wt agent create alice 1234 main
  wt agent check alice
  wt agent sync alice --auto-rebase
  wt agent prune --older-than=14d --dry-run

Structure created:
  ~/wt/<name>/
  ├── .bare/                  # Shared git objects
  │   └── worktree-metadata/  # Agent metadata
  ├── .git                    # Pointer to .bare
  ├── main/                   # Primary worktree
  └── <agent-name>/           # Agent worktrees
EOF
}

confirm_remove() {
    local path="$1"
    echo -e "${YELLOW}Directory exists: $path${NC}"
    read -p "Remove and recreate? [y/N] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]]
}

check_git_available() {
    if ! command -v git >/dev/null 2>&1; then
        log_error "git is not installed"
        echo "Please install git to use wt"
        exit 1
    fi
}

check_git_config() {
    local git_user git_email
    git_user="$(git config --global user.name 2>/dev/null || true)"
    git_email="$(git config --global user.email 2>/dev/null || true)"

    if [[ -z "$git_user" ]] || [[ -z "$git_email" ]]; then
        log_error "git user configuration is missing"
        echo "Please configure git with:"
        echo "  git config --global user.name \"Your Name\""
        echo "  git config --global user.email \"your@email.com\""
        exit 1
    fi
}

main() {
    # Handle agent subcommands
    if [[ "${1:-}" == "agent" ]]; then
        shift

        if [[ $# -eq 0 ]]; then
            echo "Error: agent command requires a subcommand"
            echo
            usage
            exit 1
        fi

        local subcommand="$1"
        shift

        # Agent commands need to be run from within a wt directory
        # Find WT_TARGET_PATH by looking for .bare directory
        local current_dir="$PWD"
        while [[ "$current_dir" != "/" ]]; do
            if [[ -d "$current_dir/.bare" ]]; then
                export WT_TARGET_PATH="$current_dir"
                break
            fi
            current_dir="$(dirname "$current_dir")"
        done

        if [[ -z "${WT_TARGET_PATH:-}" ]]; then
            log_error "Not in a wt directory (no .bare/ found in parent directories)"
            echo "Run this command from within a wt-managed directory"
            exit 1
        fi

        case "$subcommand" in
            create)
                wt_agent_create "$@"
                ;;
            remove)
                wt_agent_remove "$@"
                ;;
            list)
                wt_agent_list "$@"
                ;;
            check)
                wt_agent_check "$@"
                ;;
            sync)
                wt_agent_sync "$@"
                ;;
            prune)
                wt_agent_prune "$@"
                ;;
            status)
                wt_agent_status "$@"
                ;;
            *)
                echo "Error: unknown agent subcommand: $subcommand"
                echo
                usage
                exit 1
                ;;
        esac

        return 0
    fi

    # Check prerequisites
    check_git_available
    check_git_config

    # Parse arguments
    if ! wt_parse_args "$@"; then
        usage
        exit 1
    fi

    log_info "Mode: $WT_MODE"
    log_info "Target: $WT_TARGET_PATH"

    # Check if target exists
    if wt_target_exists; then
        if [[ -t 0 ]]; then
            # Interactive - ask for confirmation
            if ! confirm_remove "$WT_TARGET_PATH"; then
                log_warn "Aborted"
                exit 0
            fi
        else
            # Non-interactive - fail
            log_error "Target exists: $WT_TARGET_PATH"
            exit 1
        fi
        wt_remove_target
    fi

    # Setup based on mode
    if [[ "$WT_MODE" == "local" ]]; then
        log_info "Initializing local repository..."
        if ! wt_setup_local; then
            log_error "Failed to setup local repository"
            exit 1
        fi
    else
        log_info "Cloning from $WT_REPO_URL..."
        if ! wt_setup_remote; then
            log_error "Failed to clone repository"
            exit 1
        fi
    fi

    # Report success
    echo
    log_success "Worktree ready: $WT_TARGET_PATH"
    echo
    wt_list_worktrees
    echo
    wt_get_sizes
    echo
    echo "Create agent worktrees:"
    echo "  cd $WT_TARGET_PATH"
    echo "  wt agent create <agent-name> <task-id> [base-branch]"
    echo
    echo "Manage agents:"
    echo "  wt agent list    # List all agents"
    echo "  wt agent status  # Show dashboard"
}

# Run main if not being sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
